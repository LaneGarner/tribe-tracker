{
  "name": "tribe-tracker",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "web:export:e2e": "cross-env EXPO_PUBLIC_SUPABASE_URL=https://example.invalid EXPO_PUBLIC_SUPABASE_ANON_KEY=e2e-anon-key expo export --clear --platform web --output-dir .playwright-dist && node scripts/assert-web-bundle.mjs .playwright-dist",
    "web:serve:e2e": "serve -s .playwright-dist -l 4173",
    "test:e2e": "npm run web:export:e2e && playwright test",
    "typecheck": "tsc --noEmit --pretty false",
    "test:ci": "jest --runInBand",
    "export:ci:web": "expo export --platform web --output-dir .ci-dist/web && node scripts/assert-web-bundle.mjs .ci-dist/web",
    "export:ci:ios": "expo export --platform ios --output-dir .ci-dist/ios",
    "export:ci:android": "expo export --platform android --output-dir .ci-dist/android",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.3.1",
    "@expo-google-fonts/kanit": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo-google-fonts/teko": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@supabase/supabase-js": "^2.93.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "expo": "~54.0.36",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-screen-orientation": "~9.0.9",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.563.0",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.81.5",
    "react-native-bottom-tabs": "^1.3.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.5.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "tailwindcss": "^3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@playwright/test": "^1.63.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^54.0.10",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
